# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://upnabove.work

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
ADMIN_EMAIL=founder@upnabove.work

# ── Payments (Lemon Squeezy) ──────────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=your-ls-api-key
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LS_VAR_STANDARD=your-variant-id
LS_VAR_FEATURED=your-variant-id
LS_VAR_SPONSORED=your-variant-id
LS_VAR_REPLAY_SUB=your-variant-id

# ── Job Aggregation ───────────────────────────────────────────────────────────
RAPIDAPI_KEY=your-rapidapi-key
# Optional — only needed for Adzuna adapter
ADZUNA_APP_ID=your-adzuna-id
ADZUNA_APP_KEY=your-adzuna-key

# ── Cron security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret
